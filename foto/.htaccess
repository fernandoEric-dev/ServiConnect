Options -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|cgi|pl|html?|svg)$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|cgi|pl)(\.|$)">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)\.(jpg|jpeg|png|webp)$">
    SetHandler none
</FilesMatch>
